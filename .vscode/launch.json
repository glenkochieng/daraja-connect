{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ML: matching service (uvicorn, reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["daraja.api:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/ml-service",
      "justMyCode": true
    },
    {
      "name": "ML: run the whole pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ml-service/scripts/run_pipeline.py",
      "cwd": "${workspaceFolder}/ml-service",
      "console": "integratedTerminal"
    },
    {
      "name": "ML: pipeline, quick (no sensitivity analysis)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ml-service/scripts/run_pipeline.py",
      "args": ["--quick"],
      "cwd": "${workspaceFolder}/ml-service",
      "console": "integratedTerminal"
    },
    {
      "name": "ML: evaluate on test split",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ml-service/scripts/evaluate.py",
      "cwd": "${workspaceFolder}/ml-service",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal"
    }
  ]
}
