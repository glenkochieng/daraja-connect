# Daraja Connect API settings. Copy to `server/.env` (gitignored) and fill in real values.
# Never commit the real .env file.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/daraja?retryWrites=true&w=majority
# Leave empty in development to use a temporary in-memory database (seeded automatically).
MONGODB_URI=

# Long random string (at least 32 characters) used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated list of web origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

# Python matching service (ml-service/)
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=8000

# Maximum sign-in/registration attempts per IP address per 15 minutes
AUTH_RATE_LIMIT=20

# Production only: number of reverse proxies in front of the API (1 = Caddy; 2 = CloudFront + Caddy).
# It decides which address the rate limit sees, so it must match the deployment exactly.
TRUST_PROXY=1

# Administrator account, created on start-up if it does not exist yet
ADMIN_NAME=Daraja Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sample data: the synthetic members from ml-service/data/synthetic
#   auto  = seed only the in-memory development database (default)
#   true  = also seed a real MONGODB_URI database on start-up
#   false = never seed on start-up (use `npm run seed -w server` instead)
SEED_ON_START=auto
# Password shared by every SAMPLE account (e.g. mtr-0001@sample.daraja.test).
# Leave empty and sample accounts cannot be signed in to.
SEED_USER_PASSWORD=
