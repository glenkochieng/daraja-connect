# Daraja Connect client settings. Copy to .env.local only if you need to change them.
# Vite exposes VITE_* values to the browser, so never put secrets in this file.

# Base URL of the Express API. Leave empty in development: Vite proxies /api to
# http://localhost:4000 (override the proxy target with API_PROXY_TARGET).
# Set it for a production build served from a different origin than the API,
# e.g. https://api.example.com
VITE_API_URL=
