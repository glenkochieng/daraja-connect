# Daraja Connect ML service settings. Copy to .env (gitignored) to override the defaults.
# `npm run dev` at the repository root loads this file before starting the service;
# when you run uvicorn yourself, set these variables in your shell instead.
# Both are optional.

# Mentor profiles used when a request does not include its own candidate pool.
# Default: data/synthetic/mentors.json
DARAJA_MENTORS_PATH=

# Matching configuration. Default: config/matching.tuned.yaml if present, else config/matching.yaml
DARAJA_CONFIG_PATH=
